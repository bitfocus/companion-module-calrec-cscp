{
	"name": "calrec-cscp",
	"version": "1.3.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && npm run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"build:all": "(cd node-calrec-cscp && npm run build && cd .. && yarn build) 2>&1",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:check": "npx @biomejs/biome check ./src",
		"lint:fix": "npx @biomejs/biome check --write ./src"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-calrec-cscp.git"
	},
	"engines": {
		"node": "^22.14",
		"yarn": "4"
	},
	"packageManager": "yarn@4.18.0",
	"dependencies": {
		"@bitfocusas/calrec-cscp": "1.3.0",
		"@companion-module/base": "~1.12.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@companion-module/tools": "^2.7.2",
		"@types/node": "^22.20.1",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.2",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.67.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"npm run lint:fix"
		],
		"*.{ts,tsx,js,jsx}": [
			"npm run lint:fix"
		]
	}
}
